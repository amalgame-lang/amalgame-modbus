// tests/modbus_smoke.am — client against the built-in simulator.
//
// One process : starts the simulator on 127.0.0.1 (no firewall
// prompt on Windows), then checks every function code, the 16 / 32
// bit decoding with and without word swap, exceptions, argument
// checks, a refused connection and 1000 back-to-back reads.
// Runs on Linux, macOS and Windows (Winsock).

namespace ModbusTests

import Amalgame.Modbus
import Amalgame.String
import Amalgame.Console

public class Program {
    public static void Check(bool ok, string what) {
        if (ok) { Console.WriteLine("[PASS] " + what) }
        else    { Console.WriteLine("[FAIL] " + what) }
    }

    public static void Main(string[] args) {
        let port: int = 15020
        Program.Check(Modbus.ServerStart("127.0.0.1", port), "simulator listens on 127.0.0.1")

        let h: int = Modbus.Connect("127.0.0.1", port, 1000)
        Program.Check(h >= 0 && Modbus.IsConnected(h), "client connects")

        // FC03 — holding registers
        for i in 0..10 { Modbus.ServerSetHolding(i, 100 + i) }
        Program.Check(Modbus.ReadHolding(h, 1, 0, 10) == 10, "FC03 reads 10 registers")
        Program.Check(Modbus.Value(h, 0) == 100 && Modbus.Value(h, 9) == 109, "FC03 values")
        Program.Check(Modbus.LastError(h) == "", "no error after a good read")

        // 16 / 32 bit decoding
        Modbus.ServerSetHolding(50, 65535)
        Modbus.ServerSetInt32(3, 51, -100000, false)
        Modbus.ServerSetInt32(3, 53, 3000000000, true)
        Program.Check(Modbus.ReadHolding(h, 1, 50, 5) == 5, "FC03 reads 5 registers")
        Program.Check(Modbus.Value(h, 0) == 65535 && Modbus.Int16(h, 0) == -1, "uint16 / int16")
        Program.Check(Modbus.Int32(h, 1, false) == -100000, "int32, high word first")
        Program.Check(Modbus.UInt32(h, 3, true) == 3000000000, "uint32, low word first")

        // FC04 — input registers, float32 both word orders
        Modbus.ServerSetFloat32(4, 20, 21.5, false)
        Modbus.ServerSetFloat32(4, 22, -3.25, true)
        Program.Check(Modbus.ReadInput(h, 1, 20, 4) == 4, "FC04 reads 4 registers")
        Program.Check(Modbus.Float32(h, 0, false) == 21.5, "float32 ABCD")
        Program.Check(Modbus.Float32(h, 2, true) == -3.25, "float32 CDAB")

        // FC01 / FC02 — bits
        Modbus.ServerSetCoil(3, true)
        Modbus.ServerSetCoil(12, true)
        Modbus.ServerSetDiscrete(1, true)
        Program.Check(Modbus.ReadCoils(h, 1, 0, 16) == 16, "FC01 reads 16 coils")
        Program.Check(Modbus.Value(h, 3) == 1 && Modbus.Value(h, 12) == 1 && Modbus.Value(h, 2) == 0, "FC01 bits")
        Program.Check(Modbus.ReadDiscreteInputs(h, 1, 0, 3) == 3, "FC02 reads 3 inputs")
        Program.Check(Modbus.Value(h, 1) == 1 && Modbus.Value(h, 0) == 0, "FC02 bits")

        // FC05 / FC06 / FC16 — writes
        Program.Check(Modbus.WriteRegister(h, 1, 100, 4242) == 1 && Modbus.ServerGetHolding(100) == 4242, "FC06 writes a register")
        Program.Check(Modbus.WriteCoil(h, 1, 7, true) == 1 && Modbus.ServerGetCoil(7), "FC05 sets a coil")
        Program.Check(Modbus.WriteCoil(h, 1, 7, false) == 1 && !Modbus.ServerGetCoil(7), "FC05 clears a coil")
        Program.Check(Modbus.WriteRegisters(h, 1, 200, "1, 2, 3") == 1
                      && Modbus.ServerGetHolding(200) == 1 && Modbus.ServerGetHolding(202) == 3, "FC16 writes 3 registers")
        Program.Check(Modbus.WriteFloat32(h, 1, 300, 1.5, false) == 1, "FC16 writes a float32")
        Modbus.ReadHolding(h, 1, 300, 2)
        Program.Check(Modbus.Float32(h, 0, false) == 1.5, "float32 written then read back")
        Program.Check(Modbus.WriteInt32(h, 1, 310, -7, true) == 1, "FC16 writes an int32")
        Modbus.ReadHolding(h, 1, 310, 2)
        Program.Check(Modbus.Int32(h, 0, true) == -7, "int32 written then read back")

        // Exceptions and argument checks
        Modbus.ServerSetSize(1000)
        Program.Check(Modbus.ReadHolding(h, 1, 999, 2) == -2, "address past the end : exception")
        Program.Check(String_Contains(Modbus.LastError(h), "illegal data address"), "exception text")
        Modbus.ServerSetSize(65536)
        Program.Check(Modbus.ReadHolding(h, 1, 0, 126) == -4, "126 registers : rejected before sending")
        Program.Check(Modbus.WriteRegisters(h, 1, 0, "1,x") == -4, "bad register list : rejected")
        Program.Check(Modbus.ReadHolding(h, 1, 0, 1) == 1, "handle still usable after errors")

        // No device on the port : handle given, call fails fast
        let dead: int = Modbus.Connect("127.0.0.1", 15999, 300)
        Program.Check(dead >= 0 && !Modbus.IsConnected(dead), "refused connection : handle, not connected")
        Program.Check(Modbus.ReadHolding(dead, 1, 0, 1) == -1, "read on a dead device : -1")
        Program.Check(String_Contains(Modbus.LastError(dead), "cannot connect"), "connect error text")
        Modbus.Close(dead)
        Program.Check(Modbus.Connect("plc.local", 502, 300) == -1, "host name rejected (IPv4 only)")

        // Throughput
        let before: int = Modbus.ServerRequestCount()
        var ok: int = 0
        for i in 0..1000 {
            if (Modbus.ReadHolding(h, 1, 0, 10) == 10) { ok = ok + 1 }
        }
        Program.Check(ok == 1000 && Modbus.ServerRequestCount() - before == 1000, "1000 reads in a row")
        Modbus.Close(h)
        Program.Check(Modbus.ReadHolding(h, 1, 0, 1) == -4, "closed handle : rejected")
    }
}
